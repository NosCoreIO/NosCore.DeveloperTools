<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NosCore.DeveloperTools.Cli</RootNamespace>
    <AssemblyName>NosCore.DeveloperTools.Cli</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Headless driver for the NosTale client: launch, attach, control over HTTP.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Same bitness as the client, for same-arch injection. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <!-- The GUI it references is self-contained in Release, and a framework-
       dependent executable cannot reference one. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NosCore.DeveloperTools\NosCore.DeveloperTools.csproj" />
  </ItemGroup>

</Project>
